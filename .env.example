# Copy this to server/.env and fill in your keys
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_session_cryptographic_signing_key_change_me
DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quickpolls?retryWrites=true&w=majority
OPENAI_API_KEY=your_openai_api_key_here
CLIENT_URL=http://localhost:5173
